# PaperTrail Backend Environment Configuration
# Copy to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=True

# Neo4j Aura (https://console.neo4j.io)
# URI format: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=neo4j

# Pinecone (https://app.pinecone.io)
PINECONE_API_KEY=<your-api-key>
PINECONE_INDEX_NAME=papertrail
PINECONE_HOST=<index-host>.pinecone.io
PINECONE_DIMENSION=1024

# OpenRouter / OpenAI
OPENAI_API_KEY=<your-api-key>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4-turbo
